<!DOCTYPE suite SYSTEM "cmdlinetester.dtd">
<suite id="AOTValhallaFlattenableFields">
	<exec command="$JAVA_EXE$ -Xshareclasses:destroyAll" quiet="false"/>

	<variable name="FLATTENINGOPTIONS" value="-XX:+EnableFlattening -XX:-EnableArrayFlattening -XX:ValueTypeFlatteningThreshold=8"/>
	<variable name="AOTBASEOPTIONS" value="-Xaot:forceaot,limit={org/openj9/test/lworld/ValhallaAOTTestFlattened.test*},dontInline={*ContainerWithValueTypeFields*.?init?*},verbose={compileEnd}"/>

	<!--
	   - Build eight versions of SCC using two different versions of value type class Node and
	   - four different versions of a ValhAOTContainer class which has fields of type Node,
	   - some of which might be null-restricted.
	  -->
        <exec command="$JAVA_EXE$ -cp $TESTAOTVTV1PATH$$SEP$$TESTAOTVTVCONTAINERV0PATH$$SEP$$TESTSJARPATH$ --enable-preview -Xshareclasses:name=vt1.cont0,reset -Xscminaot10K -Xscmaxaot100K $AOTBASEOPTIONS$ $FLATTENINGOPTIONS$ org.openj9.test.lworld.ValhallaAOTTestFlattened" quiet="false"/>
